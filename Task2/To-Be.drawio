        <mxCell id="JNCBEwlya2eb7LY5L15N-89" value="логи" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="JNCBEwlya2eb7LY5L15N-83">
          <mxGeometry x="0.0835" y="6" relative="1" as="geometry">
